<?xml version="1.0"?>
<ruleset name="Missivus">
    <description>WordPress Coding Standards for Missivus. The vendored transport under src/Vendor keeps upstream's code style and is excluded here; it is still covered by php -l at the PHP floor and by the PHPCompatibility run.</description>

    <file>missivus.php</file>
    <file>uninstall.php</file>
    <file>src</file>

    <exclude-pattern>src/Vendor/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="extensions" value="php"/>

    <config name="minimum_wp_version" value="5.7"/>

    <rule ref="WordPress">
        <!-- PSR-4 class files, resolved by the plugin's own autoloader. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="missivus"/>
            </property>
        </properties>
    </rule>
</ruleset>
